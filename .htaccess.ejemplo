# Copia como .htaccess en la raíz del proyecto (solo aplica con Apache + mod_php, como XAMPP)
Options -Indexes
<IfModule mod_php.c>
    php_flag  session.cookie_httponly 1
    php_value session.cookie_samesite Lax
    php_flag  expose_php off
</IfModule>
<IfModule mod_php7.c>
    php_flag  session.cookie_httponly 1
    php_flag  expose_php off
</IfModule>
# Archivos que nunca deben abrirse por URL
<FilesMatch "\.(sql|log|md|zip|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
